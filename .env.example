# Repli v1 configuration
# Copy to .env and fill in your own values. NEVER commit .env.

# ---- Supabase (required) ----
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SECRET / service-role key. It bypasses Row Level Security, so it must
# stay on the server only - never in a browser, an app, or a git commit.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Publishable (anon) key - not used by the bot, kept here for reference.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for `npm run migrate`.
# Supabase → Project Settings → Database → Connection string → URI (Session pooler)
# You can leave this empty and paste the SQL files into the SQL Editor instead.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- required ----

# Owner/admin WhatsApp number(s). Country code, no "+", no spaces.
# Only these can run admin commands. Comma-separate for several admins.
# They are copied into the admin_numbers table on startup.
ADMIN_NUMBERS=919999999999

# Payment link / UPI link sent to customers.
PAYMENT_LINK=https://your-payment-link-here

# ---- business ----

BUSINESS_NAME=Repli

# Flat shipping charge in rupees (0 = free shipping).
SHIPPING_CHARGE=0

# Automated replies on/off at startup. Admin can change it live with /bot off.
BOT_ENABLED=true

# ---- runtime (optional) ----

# wwebjs = real WhatsApp (whatsapp-web.js), mock = terminal simulator
# openwa = old driver, kept for reference - it no longer connects
WA_DRIVER=wwebjs

# Allows simulateIncomingMessage() without a WhatsApp connection.
TEST_MODE=false

SESSION_ID=repli

# Which browser open-wa should drive for WhatsApp Web.
# Leave empty and Repli finds the system Chrome/Chromium by itself; only set
# this when the auto-detect misses, or on a server where you want it explicit.
#   Windows : C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS   : /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   VPS     : sudo apt install -y chromium-browser
#             CHROME_PATH=/usr/bin/chromium-browser
CHROME_PATH=

# Browser window dikhe ya nahi.
# WhatsApp Web headless browser me aksar QR code draw hi nahi karta,
# isliye pehli baar link karte waqt desktop par false rakho.
# Server par true hi rehne do (wahan koi screen hi nahi hoti).
WA_HEADLESS=true

ORDER_PREFIX=REP
MAX_QTY=10
CURRENCY=₹

# Country code used to normalise 10-digit numbers (91 = India)
COUNTRY_CODE=91

# NOTE: personal / family / friend numbers do NOT go here.
# They live in the Supabase `bypass_numbers` table (or use /bypass add).


# ---------------------------------------------------------------------
# Cache (optional)
#
# Leave REDIS_URL empty and the bot uses an in-process Map - which for a
# single process is the fastest thing there is, since a memory read is free
# and a Redis read is still a network hop.
#
# Set it and the same cache is shared: two bot processes, or the bot and the
# admin panel, stop each keeping their own private copy. Redis being
# unreachable is never fatal - the read simply falls through to Supabase,
# and a failed connection is skipped for REDIS_BACKOFF_MS rather than
# re-dialled on every message.
#
#   redis://user:pass@host:6379/0     plain
#   rediss://user:pass@host:6379      TLS - what managed Redis usually needs
# ---------------------------------------------------------------------
REDIS_URL=
REDIS_BACKOFF_MS=30000
REDIS_CONNECT_TIMEOUT_MS=3000

# Only for a private CA or a self-signed endpoint. Leave it alone otherwise.
REDIS_TLS_REJECT_UNAUTHORIZED=true

# How long each cached domain may be stale, in ms. These are short on
# purpose: nothing yet tells the bot that the panel changed a price, so the
# timer IS the freshness guarantee.
CATALOGUE_TTL_MS=15000
STOCK_TTL_MS=15000
CATEGORY_TTL_MS=15000
SETTINGS_TTL_MS=30000
TEMPLATE_TTL_MS=15000
BYPASS_TTL_MS=10000
FAQ_TTL_MS=30000
ADMIN_TTL_MS=10000


# ---------------------------------------------------------------------
# AI (optional)
#
# Leave OPENAI_API_KEY empty and the bot behaves exactly as before:
# hand-written templates, rule parser, zero cost, zero network calls.
#
# With a key, the model does two jobs and only these two:
#   1. rewrites a reply the rules already wrote, so it sounds human
#   2. reads a message the rule parser could not, choosing from options
#      the shop actually has
# It never picks prices, stock, order numbers or the next step - and every
# rewrite is checked against the original before it is sent.
# ---------------------------------------------------------------------

OPENAI_API_KEY=

# gpt-4o-mini: ~₹150/month at 5,000 messages.
# A full-size model does the same work for ~₹3,000.
OPENAI_MODEL=gpt-4o-mini

# Master switch. false = templates only, even if a key is set.
AI_ENABLED=true

# Hard ceiling in rupees, per calendar month. Spend crosses it and the AI
# switches itself off until the 1st; the shop keeps running on templates.
# 0 means no limit - use AI_ENABLED=false to turn it off instead.
AI_MONTHLY_BUDGET_INR=1000

# A customer is waiting. Slower than this and we send the template instead.
AI_TIMEOUT_MS=6000

# Only for showing spend in rupees; OpenAI bills in dollars.
AI_USD_TO_INR=88
