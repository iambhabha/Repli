# Repli v1 configuration
# Copy to .env and fill in your own values. NEVER commit .env.

# ---- Supabase (required) ----
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SECRET / service-role key. It bypasses Row Level Security, so it must
# stay on the server only - never in a browser, an app, or a git commit.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Publishable (anon) key - not used by the bot, kept here for reference.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for `npm run migrate`.
# Supabase → Project Settings → Database → Connection string → URI (Session pooler)
# You can leave this empty and paste the SQL files into the SQL Editor instead.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- required ----

# Owner/admin WhatsApp number(s). Country code, no "+", no spaces.
# Only these can run admin commands. Comma-separate for several admins.
# They are copied into the admin_numbers table on startup.
ADMIN_NUMBERS=919999999999

# Payment link / UPI link sent to customers.
PAYMENT_LINK=https://your-payment-link-here

# ---- business ----

BUSINESS_NAME=Repli

# Flat shipping charge in rupees (0 = free shipping).
SHIPPING_CHARGE=0

# Automated replies on/off at startup. Admin can change it live with /bot off.
BOT_ENABLED=true

# ---- runtime (optional) ----

# wwebjs = real WhatsApp (whatsapp-web.js), mock = terminal simulator
# openwa = old driver, kept for reference - it no longer connects
WA_DRIVER=wwebjs

# Allows simulateIncomingMessage() without a WhatsApp connection.
TEST_MODE=false

SESSION_ID=repli

# Which browser open-wa should drive for WhatsApp Web.
# Leave empty and Repli finds the system Chrome/Chromium by itself; only set
# this when the auto-detect misses, or on a server where you want it explicit.
#   Windows : C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS   : /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   VPS     : sudo apt install -y chromium-browser
#             CHROME_PATH=/usr/bin/chromium-browser
CHROME_PATH=

# Browser window dikhe ya nahi.
# WhatsApp Web headless browser me aksar QR code draw hi nahi karta,
# isliye pehli baar link karte waqt desktop par false rakho.
# Server par true hi rehne do (wahan koi screen hi nahi hoti).
WA_HEADLESS=true

ORDER_PREFIX=REP
MAX_QTY=10
CURRENCY=₹

# Country code used to normalise 10-digit numbers (91 = India)
COUNTRY_CODE=91

# How long the catalogue is cached in memory, in ms
CATALOGUE_TTL_MS=15000

# NOTE: personal / family / friend numbers do NOT go here.
# They live in the Supabase `bypass_numbers` table (or use /bypass add).
