# =====================================================================
# Repli Admin Panel - environment
# Copy to .env.local and fill in. NEVER commit .env.local.
# =====================================================================

# ---- Supabase (required) --------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" / anon key. Safe in the browser: RLS denies it everything,
# it is used only for the Supabase Auth login session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret / service-role key. SERVER ONLY - no NEXT_PUBLIC_ prefix, so Next.js
# will never ship it to the browser. Every read and write goes through it
# because RLS denies anon and authenticated by design (004_rls.sql).
SUPABASE_SECRET_KEY=

# ---- Repli backend (optional) ---------------------------------------
# HTTP bridge to the running bot process, if you expose one. Leave empty and
# outgoing WhatsApp messages are queued in the `outbound_messages` table
# instead, which the bot's outbox worker drains. The queue is the default and
# works even when the panel is on Vercel and the bot is on a laptop.
REPLI_API_URL=

# Shared secret sent as `x-repli-key` when REPLI_API_URL is set.
REPLI_API_KEY=

# ---- Payment proofs (optional) --------------------------------------
# The bot stores screenshots on its own disk (data/proofs) and saves the
# relative path in payments.proof_url. Set this when the panel runs on the
# same machine as the bot so "View proof" can stream the file.
# Example (Windows): C:\Users\you\Documents\GitHub\Repli
REPLI_ROOT=

# If you later move proofs to a private Supabase Storage bucket, name it here
# and the panel will serve short-lived signed URLs instead.
REPLI_PROOFS_BUCKET=
